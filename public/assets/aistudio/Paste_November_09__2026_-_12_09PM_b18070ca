export const PaparanMaklumanView: React.FC<PaparanMaklumanViewProps> = ({
  currentTeacher,
  allTeachers,
  schoolProfile,
  isPrincipalOrAdmin,
  addToast,
}) => {
  const [items, setItems] = useState<MaklumanTaskItem[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [uploadingTakwim, setUploadingTakwim] = useState<boolean>(false);
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  const [viewMode, setViewMode] = useState<'PEMBANTU_SAYA' | 'PEMANTAUAN_GB'>('PEMBANTU_SAYA');
  const [timeHorizon, setTimeHorizon] = useState<TimeHorizonFilter>('BULAN_INI');
  const [domainFilter, setDomainFilter] = useState<'ALL' | MaklumanDomain>('ALL');
  const [categoryFilter, setCategoryFilter] = useState<'ALL' | MaklumanCategory>('ALL');
  const [searchQuery, setSearchQuery] = useState<string>('');

  // Modal State for Adding Ad-Hoc / Scheduled Activity or Meeting
  const [isModalOpen, setIsModalOpen] = useState<boolean>(false);
  const [formTitle, setFormTitle] = useState<string>('');
  const [formDesc, setFormDesc] = useState<string>('');
  const [formDomain, setFormDomain] = useState<MaklumanDomain>('KURIKULUM');
  const [formCategory, setFormCategory] = useState<MaklumanCategory>('MESYUARAT');
  const [formDueDate, setFormDueDate] = useState<string>(getMalaysiaDateStr(0));
  const [formDueTime, setFormDueTime] = useState<string>('14:00');
  const [formLocation, setFormLocation] = useState<string>('Bilik Mesyuarat');
  const [formTindakan, setFormTindakan] = useState<string>('SEMUA GURU');
  const [formPriority, setFormPriority] = useState<'TINGGI' | 'SEDERHANA' | 'BIASA'>('TINGGI');
  const [formTargetType, setFormTargetType] = useState<'SEMUA_GURU' | 'GURU_TERPILIH'>('SEMUA_GURU');
  const [formSelectedTeachers, setFormSelectedTeachers] = useState<string[]>([]);

  // Direct WhatsApp Modal State
  const [directWaTeacher, setDirectWaTeacher] = useState<TeacherProfile | null>(null);
  const [directWaMessage, setDirectWaMessage] = useState<string>('');

  const todayStr = getMalaysiaDateStr(0);
  const tomorrowStr = getMalaysiaDateStr(1);
  const weekEndStr = getMalaysiaDateStr(7);
  const currentMonthPrefix = todayStr.slice(0, 7);

  const myTeacherId = currentTeacher?.teacherId || 'ADMIN';
  const activeTeachers = useMemo(
    () => allTeachers.filter((t) => t.status === 'ACTIVE'),
    [allTeachers]
  );

  // 1. Subscribe to Firestore `makluman_tasks`
  useEffect(() => {
    const q = query(collection(db, 'makluman_tasks'), orderBy('dueDate', 'asc'));
    const unsub = onSnapshot(
      q,
      (snap) => {
        const loaded: MaklumanTaskItem[] = [];
        snap.forEach((d) =>
          loaded.push({ id: d.id, ...(d.data() as Omit<MaklumanTaskItem, 'id'>) })
        );
        setItems(loaded);
        setLoading(false);
      },
      (err) => {
        console.error('Error loading makluman_tasks:', err);
        setLoading(false);
      }
    );
    return () => unsub();
  }, []);

  // 2. Parse & Import `TAKWIM 2027.xlsx` uploaded by Principal or PK
  const handleTakwimExcelUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      setUploadingTakwim(true);
      const buffer = await file.arrayBuffer();
      const wb = XLSX.read(buffer, { type: 'array' });

      const extractedMap = new Map<string, MaklumanTaskItem>();

      MONTH_SHEETS.forEach((sheetName, idx) => {
        const monthNum = idx + 1;
        const ws = wb.Sheets[sheetName];
        if (!ws) return;

        // Convert sheet to 2D matrix
        const rawGrid: any[][] = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
        const merges = ws['!merges'] || [];

        // Fill merged ranges so multi-row / multi-column merged blocks are preserved
        merges.forEach((m) => {
          const topVal = rawGrid[m.s.r]?.[m.s.c];
          if (topVal !== undefined && topVal !== '') {
            for (let r = m.s.r; r <= m.e.r; r++) {
              if (!rawGrid[r]) rawGrid[r] = [];
              for (let c = m.s.c; c <= m.e.c; c++) {
                rawGrid[r][c] = topVal;
              }
            }
          }
        });

        let seenJan1 = false;
        for (let r = 2; r < rawGrid.length; r++) {
          const row = rawGrid[r] || [];
          const mingguRaw = row[0];
          const tarikhRaw = row[2];
          const masaCol = String(row[3] || '').trim();
          const kuriCol = String(row[4] || '').trim();
          const hemCol = String(row[5] || '').trim();
          const kokoCol = String(row[6] || '').trim();
          const tindakanCol = String(row[7] || '').trim();

          const dayNum = parseInt(String(tarikhRaw), 10);
          if (isNaN(dayNum) || dayNum < 1 || dayNum > 31) continue;

          let actualYear = 2027;
          let actualMonth = monthNum;
          if (sheetName === 'JAN') {
            if (dayNum === 1) seenJan1 = true;
            if (!seenJan1 && dayNum >= 29) {
              actualYear = 2026;
              actualMonth = 12;
            }
          }

          const dateStr = `${actualYear}-${String(actualMonth).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
          const mingguNum = !isNaN(parseInt(String(mingguRaw), 10))
            ? parseInt(String(mingguRaw), 10)
            : null;

          // Group distinct cell texts across D, E, F, G
          const cellOrigins = new Map<string, string[]>();
          [
            { col: 'MASA', val: masaCol },
            { col: 'KURIKULUM', val: kuriCol },
            { col: 'HEM', val: hemCol },
            { col: 'KOKURIKULUM', val: kokoCol },
          ].forEach(({ col, val }) => {
            if (val) {
              const list = cellOrigins.get(val) || [];
              list.push(col);
              cellOrigins.set(val, list);
            }
          });

          cellOrigins.forEach((cols, cellText) => {
            const upperFull = cellText.toUpperCase();
            const isHoliday = [
              'CUTI', 'CUTU', 'GOOD FRIDAY', 'EASTER', 'CHING MING',
              'HARI RAYA', 'WESAK', 'DRAGON BOAT', 'HARI SARAWAK',
              'MAULIDUR', 'MOON CAKE', 'HARI MALAYSIA', 'DEEPAVALI',
              'HARI KEPUTERAAN', 'HARI KEBANGSAAN'
            ].some((k) => upperFull.includes(k));

            if (isHoliday) {
              const cleanHoliday = cellText
                .split('\n')
                .map((l) => l.trim())
                .filter(Boolean)
                .join(' ');
              const docId = `takwim_${dateStr}_${cleanHoliday.replace(/[^A-Z0-9]/gi, '_').slice(0, 35)}`;
              extractedMap.set(docId, {
                id: docId,
                title: cleanHoliday,
                description: `Cuti Takwim Sekolah (${sheetName})`,
                domain: 'CUTI',
                category: 'AKTIVITI',
                source: 'TAKWIM_UPLOAD',
                mingguPersekolahan: mingguNum,
                dueDate: dateStr,
                tindakanLabel: 'WARGA SEKOLAH',
                priority: 'BIASA',
                targetType: 'SEMUA_GURU',
                targetTeacherIds: [],
                completions: {},
                whatsappLogs: {},
                createdByTeacherId: myTeacherId,
                createdByName: currentTeacher?.fullName || 'Pentadbir (Import Takwim)',
                createdAt: new Date().toISOString(),
              });
            } else {
              cellText
                .split('\n')
                .map((l) => l.trim())
                .filter(Boolean)
                .forEach((line) => {
                  const uLine = line.toUpperCase();
                  let dom: MaklumanDomain = 'KURIKULUM';
                  if (uLine.includes('KOKURIKULUM') || uLine.includes('SUKAN') || uLine.includes('MERENTAS DESA')) {
                    dom = 'KOKURIKULUM';
                  } else if (
                    uLine.includes('MESYUARAT HEM') ||
                    uLine.includes('PENDAFTARAN') ||
                    uLine.includes('SPBT') ||
                    uLine.includes('3K') ||
                    uLine.includes('DISIPLIN')
                  ) {
                    dom = 'HEM';
                  } else if (uLine.includes('MESYUARAT STAF') || uLine.includes('PENGURUSAN SEKOLAH')) {
                    dom = 'PENTADBIRAN';
                  } else if (
                    uLine.includes('KURIKULUM') ||
                    uLine.includes('PANITIA') ||
                    uLine.includes('TRANSISI') ||
                    uLine.includes('ORIENTASI') ||
                    uLine.includes('MINGGU PERTAMA') ||
                    uLine.includes('UASA') ||
                    uLine.includes('PBD')
                  ) {
                    dom = 'KURIKULUM';
                  } else if (cols.length === 1 && (cols[0] === 'HEM' || cols[0] === 'KOKURIKULUM' || cols[0] === 'KURIKULUM')) {
                    dom = cols[0] as MaklumanDomain;
                  }

                  let cat: MaklumanCategory = 'AKTIVITI';
                  if (uLine.includes('MESYUARAT') || uLine.includes('TAKLIMAT') || uLine.includes('PLC')) {
                    cat = 'MESYUARAT';
                  } else if (uLine.includes('KURSUS') || uLine.includes('BENGKEL') || uLine.includes('LDP')) {
                    cat = 'KURSUS';
                  } else if (uLine.includes('PERTANDINGAN') || uLine.includes('KEJOHANAN')) {
                    cat = 'PERTANDINGAN';
                  }

                  const docId = `takwim_${dateStr}_${line.replace(/[^A-Z0-9]/gi, '_').slice(0, 35)}`;
                  extractedMap.set(docId, {
                    id: docId,
                    title: line,
                    description: tindakanCol && tindakanCol !== cellText ? `Tindakan: ${tindakanCol}` : `Aktiviti Takwim ${actualYear}`,
                    domain: dom,
                    category: cat,
                    source: 'TAKWIM_UPLOAD',
                    mingguPersekolahan: mingguNum,
                    dueDate: dateStr,
                    tindakanLabel: tindakanCol && tindakanCol !== cellText ? tindakanCol : 'SEMUA GURU',
                    priority: cat === 'MESYUARAT' ? 'TINGGI' : 'SEDERHANA',
                    targetType: 'SEMUA_GURU',
                    targetTeacherIds: [],
                    completions: {},
                    whatsappLogs: {},
                    createdByTeacherId: myTeacherId,
                    createdByName: currentTeacher?.fullName || 'Pentadbir (Import Takwim)',
                    createdAt: new Date().toISOString(),
                  });
                });
            }
          });
        }
      });

      const records = Array.from(extractedMap.values());
      const batch = writeBatch(db);
      records.forEach((rec) => {
        batch.set(doc(db, 'makluman_tasks', rec.id), rec, { merge: true });
      });
      await batch.commit();

      addToast(
        `Berjaya memuat naik Takwim! ${records.filter((r) => r.domain !== 'CUTI').length} aktiviti/mesyuarat & ${records.filter((r) => r.domain === 'CUTI').length} rekod cuti telah diselaraskan.`,
        'success'
      );
    } catch (err: any) {
      console.error('Takwim import error:', err);
      addToast(`Gagal membaca fail Takwim: ${err.message}`, 'warning');
    } finally {
      setUploadingTakwim(false);
      if (fileInputRef.current) fileInputRef.current.value = '';
    }
  };

  // 3. Domain Activity Counters (Kurikulum, HEM, Kokurikulum, Pentadbiran)
  const domainCounters = useMemo(() => {
    const stats: Record<
      MaklumanDomain,
      { total: number; fromTakwim: number; fromAdHoc: number; completedByMe: number }
    > = {
      KURIKULUM: { total: 0, fromTakwim: 0, fromAdHoc: 0, completedByMe: 0 },
      HEM: { total: 0, fromTakwim: 0, fromAdHoc: 0, completedByMe: 0 },
      KOKURIKULUM: { total: 0, fromTakwim: 0, fromAdHoc: 0, completedByMe: 0 },
      PENTADBIRAN: { total: 0, fromTakwim: 0, fromAdHoc: 0, completedByMe: 0 },
      CUTI: { total: 0, fromTakwim: 0, fromAdHoc: 0, completedByMe: 0 },
    };

    items.forEach((item) => {
      const dom = item.domain || 'KURIKULUM';
      if (!stats[dom]) return;
      stats[dom].total++;
      if (item.source === 'TAKWIM_UPLOAD') {
        stats[dom].fromTakwim++;
      } else {
        stats[dom].fromAdHoc++;
      }
      if (item.completions?.[myTeacherId]?.completed) {
        stats[dom].completedByMe++;
      }
    });

    return stats;
  }, [items, myTeacherId]);

  const isTaskAssignedToTeacher = (item: MaklumanTaskItem, teacherId: string): boolean => {
    if (item.targetType === 'SEMUA_GURU') return true;
    return (item.targetTeacherIds || []).includes(teacherId);
  };

  const myTasks = useMemo(() => {
    return items.filter((item) => isTaskAssignedToTeacher(item, myTeacherId));
  }, [items, myTeacherId]);

  // Horizon Counts (Excluding CUTI from overdue count so holidays don't trigger overdue warnings)
  const myHorizonCounts = useMemo(() => {
    let hariIni = 0;
    let esok = 0;
    let mingguIni = 0;
    let bulanIni = 0;
    let tertunggak = 0;

    myTasks.forEach((t) => {
      const comp = t.completions?.[myTeacherId]?.completed || false;
      const isHoliday = t.domain === 'CUTI';
      if (!comp && !isHoliday && t.dueDate < todayStr) {
        tertunggak++;
      }
      if (t.dueDate === todayStr) hariIni++;
      if (t.dueDate === tomorrowStr) esok++;
      if (t.dueDate >= todayStr && t.dueDate <= weekEndStr) mingguIni++;
      if (t.dueDate.startsWith(currentMonthPrefix)) bulanIni++;
    });

    return { hariIni, esok, mingguIni, bulanIni, tertunggak };
  }, [myTasks, myTeacherId, todayStr, tomorrowStr, weekEndStr, currentMonthPrefix]);

  const filteredMyTasks = useMemo(() => {
    return myTasks.filter((t) => {
      const isDone = t.completions?.[myTeacherId]?.completed || false;
      const isHoliday = t.domain === 'CUTI';

      if (timeHorizon === 'TERTUNGGAK' && (isDone || isHoliday || t.dueDate >= todayStr)) return false;
      if (timeHorizon === 'HARI_INI' && t.dueDate !== todayStr) return false;
      if (timeHorizon === 'ESOK' && t.dueDate !== tomorrowStr) return false;
      if (timeHorizon === 'MINGGU_INI' && (t.dueDate < todayStr || t.dueDate > weekEndStr)) return false;
      if (timeHorizon === 'BULAN_INI' && !t.dueDate.startsWith(currentMonthPrefix)) return false;

      if (domainFilter !== 'ALL' && (t.domain || 'KURIKULUM') !== domainFilter) return false;
      if (categoryFilter !== 'ALL' && t.category !== categoryFilter) return false;

      if (
        searchQuery.trim() &&
        !t.title.toLowerCase().includes(searchQuery.toLowerCase()) &&
        !(t.description || '').toLowerCase().includes(searchQuery.toLowerCase()) &&
        !(t.tindakanLabel || '').toLowerCase().includes(searchQuery.toLowerCase())
      ) {
        return false;
      }
      return true;
    });
  }, [
    myTasks,
    myTeacherId,
    timeHorizon,
    domainFilter,
    categoryFilter,
    searchQuery,
    todayStr,
    tomorrowStr,
    weekEndStr,
    currentMonthPrefix,
  ]);

  // Toggle Completion
  const handleToggleCompletion = async (item: MaklumanTaskItem, targetTeacherId: string) => {
    try {
      const currentComp = item.completions?.[targetTeacherId];
      const nextCompleted = !currentComp?.completed;
      const nowIso = new Date().toISOString();
      const nowDateStr = getMalaysiaDateStr(0);
      const lateDays = Math.max(0, diffDays(nowDateStr, item.dueDate));
      const isLate = nowDateStr > item.dueDate;

      const updatedCompletions = { ...(item.completions || {}) };
      if (nextCompleted) {
        updatedCompletions[targetTeacherId] = {
          completed: true,
          completedAt: nowIso,
          completedDateStr: nowDateStr,
          isLate,
          daysLate: lateDays,
        };
      } else {
        delete updatedCompletions[targetTeacherId];
      }

      await updateDoc(doc(db, 'makluman_tasks', item.id), {
        completions: updatedCompletions,
      });

      addToast(
        nextCompleted
          ? isLate
            ? `Ditandakan selesai (Direkod lewat ${lateDays} hari).`
            : 'Syabas! Ditandakan selesai mengikut masa.'
          : 'Tanda selesai telah dibatalkan.',
        nextCompleted ? (isLate ? 'warning' : 'success') : 'info'
      );
    } catch (err: any) {
      addToast(`Ralat menyimpan status: ${err.message}`, 'warning');
    }
  };

  // Send WhatsApp Reminder & Record Audit Trail
  const handleSendWhatsAppReminder = async (
    item: MaklumanTaskItem,
    teacher: TeacherProfile,
    noteType: 'REMINDER' | 'OVERDUE_WARN'
  ) => {
    const cleanPhone = formatWhatsAppPhone(teacher.phone);
    if (!cleanPhone) {
      addToast(
        `Tiada nombor telefon bagi ${teacher.fullName}. Sila kemas kini di Senarai Kakitangan.`,
        'warning'
      );
      return;
    }

    const schoolName = schoolProfile?.schoolName || 'SJK(C) CHUNG HUA BALINGIAN';
    const domLabel = DOMAIN_META[item.domain || 'KURIKULUM'].label;
    const catLabel = CATEGORY_META[item.category].label;
    const lateDays = Math.max(0, diffDays(todayStr, item.dueDate));

    const messageLines =
      noteType === 'OVERDUE_WARN'
        ? [
            `*[NOTIS TERTUNGGAK iSEPADU — ${schoolName}]*`,
            `Selamat sejahtera Cikgu *${teacher.fullName}*,`,
            ``,
            `Sistem mengesan perkara berikut telah *melepasi tarikh akhir (${lateDays} hari lewat)* dan masih belum ditandakan selesai:`,
            `📌 *Perkara:* ${item.title}`,
            `🏛️ *Komponen:* ${domLabel} (${catLabel})`,
            `📅 *Tarikh Akhir:* ${item.dueDate}${item.dueTime ? ` (${item.dueTime})` : ''}`,
            `📝 *Tindakan/Butiran:* ${item.tindakanLabel || item.description || '-'}`,
            ``,
            `Mohon ambil tindakan segera dan tandakan selesai (✔) dalam Paparan Makluman iSEPADU. Rekod ketepatan masa ini disimpan secara automatik sebagai bukti penilaian tahunan. Terima kasih.`,
          ]
        : [
            `*[PERINGATAN TAKWIM & MAKLUMAN iSEPADU — ${schoolName}]*`,
            `Selamat sejahtera Cikgu *${teacher.fullName}*,`,
            ``,
            `Berikut adalah peringatan mesra bagi aktiviti/mesyuarat/tugasan sekolah:`,
            `📌 *Perkara:* ${item.title}`,
            `🏛️ *Komponen:* ${domLabel} (${catLabel})`,
            `📅 *Tarikh / Masa:* ${item.dueDate}${item.dueTime ? ` (${item.dueTime})` : ''}`,
            item.location ? `📍 *Lokasi:* ${item.location}` : '',
            `👥 *Tindakan:* ${item.tindakanLabel || item.description || '-'}`,
            ``,
            `Sila tandakan selesai (✔) dalam Paparan Makluman iSEPADU sebaik sahaja selesai. Terima kasih!`,
          ].filter(Boolean);

    const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(messageLines.join('\n'))}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');

    try {
      const existingLog = item.whatsappLogs?.[teacher.teacherId] || {
        count: 0,
        lastSentAt: '',
        lastSentBy: '',
        history: [],
      };
      const nowIso = new Date().toISOString();
      const senderName = currentTeacher?.fullName || 'Guru Besar / Pentadbir';

      const updatedLogs = {
        ...(item.whatsappLogs || {}),
        [teacher.teacherId]: {
          count: existingLog.count + 1,
          lastSentAt: nowIso,
          lastSentBy: senderName,
          history: [
            ...(existingLog.history || []),
            { sentAt: nowIso, sentBy: senderName, noteType },
          ],
        },
      };

      await updateDoc(doc(db, 'makluman_tasks', item.id), {
        whatsappLogs: updatedLogs,
      });

      addToast(`Peringatan WhatsApp kepada ${teacher.fullName} telah direkodkan.`, 'success');
    } catch (err) {
      console.error('Error logging WhatsApp reminder:', err);
    }
  };

  // Create Ad-Hoc / Temporary Meeting or Activity
  const handleCreateMakluman = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!formTitle.trim()) return;

    try {
      const newId = `adhoc_${Date.now()}`;
      const payload: MaklumanTaskItem = {
        id: newId,
        title: formTitle.trim(),
        description: formDesc.trim(),
        domain: formDomain,
        category: formCategory,
        source: 'AD_HOC',
        dueDate: formDueDate,
        dueTime: formDueTime,
        location: formLocation.trim(),
        tindakanLabel: formTindakan.trim() || 'SEMUA GURU',
        priority: formPriority,
        targetType: formTargetType,
        targetTeacherIds: formTargetType === 'SEMUA_GURU' ? [] : formSelectedTeachers,
        completions: {},
        whatsappLogs: {},
        createdByTeacherId: myTeacherId,
        createdByName: currentTeacher?.fullName || 'Guru / Pentadbir',
        createdAt: new Date().toISOString(),
      };

      await setDoc(doc(db, 'makluman_tasks', newId), payload);
      setIsModalOpen(false);
      setFormTitle('');
      setFormDesc('');
      addToast(
        `Aktiviti / Mesyuarat (${DOMAIN_META[formDomain].label}) berjaya ditambah ke dalam Makluman!`,
        'success'
      );
    } catch (err: any) {
      addToast(`Gagal menambah rekod: ${err.message}`, 'warning');
    }
  };

  // Principal Overdue & PBPPP Compliance Evidence Stats
  const teacherComplianceStats = useMemo(() => {
    return activeTeachers.map((teacher) => {
      const assignedItems = items.filter(
        (item) => item.domain !== 'CUTI' && isTaskAssignedToTeacher(item, teacher.teacherId)
      );
      let completedOnTime = 0;
      let completedLate = 0;
      let overduePending = 0;
      let totalWaReminders = 0;

      const overdueList: { item: MaklumanTaskItem; daysLate: number; waCount: number }[] = [];

      assignedItems.forEach((item) => {
        const comp = item.completions?.[teacher.teacherId];
        const waLog = item.whatsappLogs?.[teacher.teacherId];
        if (waLog?.count) totalWaReminders += waLog.count;

        if (comp?.completed) {
          if (comp.isLate) completedLate++;
          else completedOnTime++;
        } else if (item.dueDate < todayStr) {
          overduePending++;
          overdueList.push({
            item,
            daysLate: diffDays(todayStr, item.dueDate),
            waCount: waLog?.count || 0,
          });
        }
      });

      const totalEvaluated = completedOnTime + completedLate + overduePending;
      const complianceScore =
        totalEvaluated === 0
          ? 100
          : Math.round(((completedOnTime * 1.0 + completedLate * 0.6) / totalEvaluated) * 100);

      return {
        teacher,
        totalAssigned: assignedItems.length,
        completedOnTime,
        completedLate,
        overduePending,
        totalWaReminders,
        complianceScore,
        overdueList,
      };
    });
  }, [activeTeachers, items, todayStr]);

  return (
    <div className="flex-1 flex flex-col gap-6 max-w-6xl">
      {/* Top Header & Takwim Upload / Ad-Hoc Controls */}
      <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2">
            <span className="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
              Takwim Sekolah & Pembantu Makluman iSEPADU
            </span>
            <span className="text-xs text-slate-400 font-mono">Hari Ini: {todayStr}</span>
          </div>
          <h2 className="text-xl sm:text-2xl font-black text-white mt-1 flex items-center gap-2.5">
            <Bell className="w-6 h-6 text-indigo-400" />
            <span>Paparan Makluman, Takwim & Pemantauan Tugas</span>
          </h2>
          <p className="text-xs text-slate-400 mt-1">
            Menyelaras aktiviti Takwim Tahunan serta mesyuarat/program tambahan (Ad-Hoc) mengikut komponen Kurikulum, HEM dan Kokurikulum.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2.5">
          {/* Hidden File Input for TAKWIM 2027.xlsx Upload */}
          <input
            ref={fileInputRef}
            type="file"
            accept=".xlsx,.xls"
            onChange={handleTakwimExcelUpload}
            className="hidden"
          />

          {/* Upload Takwim Excel Button (Principal & PKs) */}
          {isPrincipalOrAdmin && (
            <button
              type="button"
              disabled={uploadingTakwim}
              onClick={() => fileInputRef.current?.click()}
              className="flex items-center gap-1.5 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white rounded-2xl text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-emerald-600/25 cursor-pointer"
            >
              <Upload className="w-4 h-4" />
              <span>{uploadingTakwim ? 'Memproses Takwim...' : 'Muat Naik Takwim (.xlsx)'}</span>
            </button>
          )}

          {/* Add Ad-Hoc Meeting / Activity Button (All Teachers, PKs & GB) */}
          <button
            type="button"
            onClick={() => setIsModalOpen(true)}
            className="flex items-center gap-1.5 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-2xl text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-indigo-600/25 cursor-pointer"
          >
            <Plus className="w-4 h-4" />
            <span>+ Mesyuarat / Aktiviti Baharu</span>
          </button>

          {/* View Switcher for Principal / Admin */}
          {isPrincipalOrAdmin && (
            <div className="flex bg-slate-950 p-1 rounded-2xl border border-slate-800">
              <button
                onClick={() => setViewMode('PEMBANTU_SAYA')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  viewMode === 'PEMBANTU_SAYA'
                    ? 'bg-indigo-600 text-white'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
              >
                Senarai Makluman
              </button>
              <button
                onClick={() => setViewMode('PEMANTAUAN_GB')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1 cursor-pointer ${
                  viewMode === 'PEMANTAUAN_GB'
                    ? 'bg-rose-600 text-white'
                    : 'text-slate-400 hover:text-rose-300'
                }`}
              >
                <ShieldAlert className="w-3.5 h-3.5" />
                <span>Radar & Bukti PBPPP</span>
              </button>
            </div>
          )}
        </div>
      </div>

      {/* ===================================================================== */}
      {/* DOMAIN COUNTER CARDS (KURIKULUM / HEM / KOKURIKULUM / PENTADBIRAN)     */}
      {/* ===================================================================== */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        {(['KURIKULUM', 'HEM', 'KOKURIKULUM', 'PENTADBIRAN', 'CUTI'] as MaklumanDomain[]).map(
          (dom) => {
            const meta = DOMAIN_META[dom];
            const stat = domainCounters[dom];
            const isSelected = domainFilter === dom;

            return (
              <button
                key={dom}
                type="button"
                onClick={() => setDomainFilter(isSelected ? 'ALL' : dom)}
                className={`p-4 rounded-2xl border text-left transition-all cursor-pointer ${
                  isSelected
                    ? `${meta.bgClass} ${meta.borderClass} ring-2 ring-indigo-400`
                    : 'bg-slate-900/80 border-slate-800 hover:border-slate-700'
                }`}
              >
                <div className="flex items-center justify-between">
                  <span className={`text-xs font-extrabold uppercase ${meta.colorClass}`}>
                    {meta.label}
                  </span>
                  <span className="text-xl font-black text-white font-mono">{stat.total}</span>
                </div>
                <div className="mt-2 flex items-center justify-between text-[10px] font-mono text-slate-400">
                  <span>Takwim: {stat.fromTakwim}</span>
                  <span>Tambahan: {stat.fromAdHoc}</span>
                  {dom !== 'CUTI' && (
                    <span className="text-emerald-400 font-bold">✔ {stat.completedByMe}</span>
                  )}
                </div>
              </button>
            );
          }
        )}
      </div>

      {/* ===================================================================== */}
      {/* VIEW 1: TEACHER ASSISTANT & TAKWIM CHECKLIST                          */}
      {/* ===================================================================== */}
      {viewMode === 'PEMBANTU_SAYA' && (
        <div className="space-y-5">
          {/* Time Horizon Filter Cards */}
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
            {[
              { id: 'HARI_INI' as TimeHorizonFilter, label: 'Hari Ini', count: myHorizonCounts.hariIni },
              { id: 'ESOK' as TimeHorizonFilter, label: 'Esok', count: myHorizonCounts.esok },
              { id: 'MINGGU_INI' as TimeHorizonFilter, label: 'Minggu Ini', count: myHorizonCounts.mingguIni },
              { id: 'BULAN_INI' as TimeHorizonFilter, label: 'Bulan Ini', count: myHorizonCounts.bulanIni },
              {
                id: 'TERTUNGGAK' as TimeHorizonFilter,
                label: 'Tertunggak!',
                count: myHorizonCounts.tertunggak,
                alert: myHorizonCounts.tertunggak > 0,
              },
              { id: 'SEMUA' as TimeHorizonFilter, label: 'Semua Takwim', count: myTasks.length },
            ].map((h) => (
              <button
                key={h.id}
                onClick={() => setTimeHorizon(h.id)}
                className={`px-3.5 py-3 rounded-2xl border text-left transition cursor-pointer flex items-center justify-between ${
                  timeHorizon === h.id
                    ? 'bg-indigo-600 text-white border-indigo-400 shadow-md'
                    : h.alert
                    ? 'bg-rose-950/50 border-rose-500/50 text-rose-300'
                    : 'bg-slate-900/60 border-slate-800 text-slate-300 hover:border-slate-700'
                }`}
              >
                <span className="text-xs font-extrabold">{h.label}</span>
                <span className="text-sm font-black font-mono px-2 py-0.5 rounded-lg bg-black/25">
                  {h.count}
                </span>
              </button>
            ))}
          </div>

          {/* Category Filter & Search */}
          <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-3 flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div className="flex flex-wrap items-center gap-1.5">
              <button
                onClick={() => setCategoryFilter('ALL')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                  categoryFilter === 'ALL'
                    ? 'bg-indigo-600 text-white'
                    : 'text-slate-400 hover:text-white hover:bg-slate-800'
                }`}
              >
                Semua Jenis
              </button>
              {(Object.keys(CATEGORY_META) as MaklumanCategory[]).map((cat) => (
                <button
                  key={cat}
                  onClick={() => setCategoryFilter(cat)}
                  className={`px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                    categoryFilter === cat
                      ? 'bg-indigo-600 text-white'
                      : 'text-slate-400 hover:text-white hover:bg-slate-800'
                  }`}
                >
                  {CATEGORY_META[cat].label}
                </button>
              ))}
            </div>

            <div className="relative w-full md:w-64">
              <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" />
              <input
                type="text"
                placeholder="Cari aktiviti / panitia / tindakan..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full pl-8 pr-3 py-1.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500"
              />
            </div>
          </div>

          {/* List of Items */}
          <div className="space-y-3">
            {loading ? (
              <div className="p-12 text-center text-slate-400 text-xs font-mono">
                Memuatkan data Takwim & Makluman...
              </div>
            ) : filteredMyTasks.length === 0 ? (
              <div className="bg-slate-900/60 border border-slate-800 rounded-3xl p-12 text-center space-y-2">
                <CheckCircle2 className="w-10 h-10 text-emerald-400 mx-auto opacity-80" />
                <p className="text-sm font-bold text-slate-200">
                  Tiada rekod dalam penapis masa/komponen ini.
                </p>
                <p className="text-xs text-slate-400">
                  Anda boleh memuat naik fail TAKWIM 2027.xlsx atau menambah mesyuarat/aktiviti secara terus.
                </p>
              </div>
            ) : (
              filteredMyTasks.map((item) => {
                const myComp = item.completions?.[myTeacherId];
                const isDone = myComp?.completed || false;
                const isHoliday = item.domain === 'CUTI';
                const isOverdue = !isDone && !isHoliday && item.dueDate < todayStr;
                const lateDays = isOverdue ? diffDays(todayStr, item.dueDate) : 0;
                const domMeta = DOMAIN_META[item.domain || 'KURIKULUM'];
                const CatIcon = CATEGORY_META[item.category].icon;

                return (
                  <div
                    key={item.id}
                    className={`p-5 rounded-3xl border transition-all flex flex-col md:flex-row md:items-center justify-between gap-4 ${
                      isHoliday
                        ? 'bg-rose-950/15 border-rose-500/25'
                        : isDone
                        ? 'bg-slate-900/40 border-slate-800/60 opacity-75'
                        : isOverdue
                        ? 'bg-rose-950/25 border-rose-500/40 shadow-lg'
                        : 'bg-slate-900 border-slate-800 hover:border-indigo-500/40'
                    }`}
                  >
                    <div className="flex items-start gap-4 min-w-0">
                      {!isHoliday && (
                        <button
                          type="button"
                          onClick={() => handleToggleCompletion(item, myTeacherId)}
                          className={`mt-1 w-7 h-7 rounded-xl flex items-center justify-center shrink-0 border-2 transition-all cursor-pointer ${
                            isDone
                              ? 'bg-emerald-600 border-emerald-500 text-white'
                              : isOverdue
                              ? 'bg-rose-950 border-rose-400 text-transparent'
                              : 'bg-slate-950 border-slate-600 hover:border-indigo-400 text-transparent'
                          }`}
                          title={isDone ? 'Batal tanda selesai' : 'Tandakan selesai (✔)'}
                        >
                          <Check className="w-4 h-4 stroke-[3]" />
                        </button>
                      )}

                      <div className="space-y-1.5 min-w-0">
                        <div className="flex flex-wrap items-center gap-2">
                          {/* Domain Badge (Kurikulum / HEM / Kokurikulum) */}
                          <span
                            className={`px-2.5 py-0.5 rounded-lg text-[10px] font-black uppercase border ${domMeta.bgClass} ${domMeta.colorClass} ${domMeta.borderClass}`}
                          >
                            {domMeta.label}
                          </span>

                          {/* Category Badge */}
                          <span
                            className={`px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase border flex items-center gap-1 ${CATEGORY_META[item.category].badgeClass}`}
                          >
                            <CatIcon className="w-3 h-3" />
                            <span>{CATEGORY_META[item.category].label}</span>
                          </span>

                          {/* Source Tag: Takwim vs Ad-Hoc */}
                          <span className="px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px] font-mono">
                            {item.source === 'TAKWIM_UPLOAD'
                              ? `Takwim${item.mingguPersekolahan ? ` (M${item.mingguPersekolahan})` : ''}`
                              : 'Tambahan (Ad-Hoc)'}
                          </span>

                          <span className="text-xs font-mono font-bold text-slate-200 flex items-center gap-1">
                            <Calendar className="w-3.5 h-3.5 text-slate-400" />
                            {item.dueDate}
                            {item.dueTime && ` • ${item.dueTime}`}
                          </span>

                          {isOverdue && (
                            <span className="px-2 py-0.5 rounded-lg bg-rose-600 text-white text-[10px] font-black uppercase">
                              LEWAT {lateDays} HARI!
                            </span>
                          )}

                          {isDone && (
                            <span
                              className={`px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase ${
                                myComp?.isLate
                                  ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30'
                                  : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
                              }`}
                            >
                              {myComp?.isLate
                                ? `Selesai Lewat (${myComp.daysLate} Hari)`
                                : `Selesai Ikut Masa`}
                            </span>
                          )}
                        </div>

                        <h4
                          className={`text-base font-extrabold ${
                            isDone ? 'line-through text-slate-400' : 'text-white'
                          }`}
                        >
                          {item.title}
                        </h4>

                        <div className="flex flex-wrap items-center gap-4 text-xs text-slate-400">
                          {item.tindakanLabel && (
                            <span>
                              👥 <strong className="text-slate-300">Tindakan:</strong> {item.tindakanLabel}
                            </span>
                          )}
                          {item.location && (
                            <span>
                              📍 <strong className="text-slate-300">Lokasi:</strong> {item.location}
                            </span>
                          )}
                          {item.description && <span>📝 {item.description}</span>}
                        </div>
                      </div>
                    </div>

                    {!isHoliday && currentTeacher && (
                      <div className="flex items-center gap-2 shrink-0 self-end md:self-center">
                        <button
                          type="button"
                          onClick={() =>
                            handleSendWhatsAppReminder(
                              item,
                              currentTeacher,
                              isOverdue ? 'OVERDUE_WARN' : 'REMINDER'
                            )
                          }
                          className="px-3 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600 text-emerald-300 hover:text-white border border-emerald-500/30 text-xs font-bold flex items-center gap-1.5 transition cursor-pointer"
                        >
                          <MessageSquare className="w-3.5 h-3.5" />
                          <span>WhatsApp</span>
                        </button>
                      </div>
                    )}
                  </div>
                );
              })
            )}
          </div>
        </div>
      )}

      {/* ===================================================================== */}
      {/* VIEW 2: PRINCIPAL OVERDUE RADAR & PBPPP EVIDENCE SCORECARD            */}
      {/* ===================================================================== */}
      {viewMode === 'PEMANTAUAN_GB' && isPrincipalOrAdmin && (
        <div className="space-y-6">
          <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-4">
            <h3 className="text-base font-black text-white uppercase tracking-wider flex items-center gap-2">
              <BarChart2 className="w-5 h-5 text-indigo-400" />
              <span>Skor Ketepatan Masa & Bukti Penilaian Akhir Tahun (PBPPP)</span>
            </h3>
            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs border-collapse">
                <thead>
                  <tr className="bg-slate-950 text-slate-400 uppercase font-mono text-[10px] border-b border-slate-800">
                    <th className="py-3 px-4">Nama Guru</th>
                    <th className="py-3 px-3 text-center">Jumlah Tugas</th>
                    <th className="py-3 px-3 text-center text-emerald-400">Ikut Masa</th>
                    <th className="py-3 px-3 text-center text-amber-400">Selesai Lewat</th>
                    <th className="py-3 px-3 text-center text-rose-400">Tertunggak</th>
                    <th className="py-3 px-3 text-center">Peringatan WA</th>
                    <th className="py-3 px-3 text-center">Skor PBPPP</th>
                    <th className="py-3 px-4 text-right">Tindakan WhatsApp</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/60 font-mono">
                  {teacherComplianceStats.map((stat) => (
                    <tr key={stat.teacher.teacherId} className="hover:bg-slate-800/40">
                      <td className="py-3 px-4 font-sans font-bold text-white">
                        <div>{stat.teacher.fullName}</div>
                        <div className="text-[10px] text-slate-400 font-mono">
                          {stat.teacher.phone || 'Tiada No. Tel'}
                        </div>
                      </td>
                      <td className="py-3 px-3 text-center font-bold text-slate-200">
                        {stat.totalAssigned}
                      </td>
                      <td className="py-3 px-3 text-center font-bold text-emerald-400">
                        {stat.completedOnTime}
                      </td>
                      <td className="py-3 px-3 text-center font-bold text-amber-400">
                        {stat.completedLate}
                      </td>
                      <td className="py-3 px-3 text-center font-bold text-rose-400">
                        {stat.overduePending}
                      </td>
                      <td className="py-3 px-3 text-center text-slate-300">
                        {stat.totalWaReminders}x
                      </td>
                      <td className="py-3 px-3 text-center">
                        <span className="px-2.5 py-1 rounded-lg text-xs font-black bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                          {stat.complianceScore}%
                        </span>
                      </td>
                      <td className="py-3 px-4 text-right font-sans">
                        <button
                          type="button"
                          onClick={() => {
                            if (stat.overdueList.length > 0) {
                              handleSendWhatsAppReminder(
                                stat.overdueList[0].item,
                                stat.teacher,
                                'OVERDUE_WARN'
                              );
                            } else {
                              setDirectWaTeacher(stat.teacher);
                              setDirectWaMessage(
                                `Tahniah Cikgu ${stat.teacher.fullName}, rekod pelaksanaan tugas Takwim anda berada pada tahap ${stat.complianceScore}%.`
                              );
                            }
                          }}
                          className="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold inline-flex items-center gap-1.5 cursor-pointer"
                        >
                          <Send className="w-3.5 h-3.5" />
                          <span>{stat.overduePending > 0 ? 'WA Teguran' : 'WA Guru'}</span>
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* ===================================================================== */}
      {/* MODAL: ADD AD-HOC MEETING / ACTIVITY (CLASSIFIED BY DOMAIN)           */}
      {/* ===================================================================== */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-3xl max-w-xl w-full p-6 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <h3 className="text-base font-black text-white">
                Tambah Mesyuarat / Aktiviti / Tugasan Baharu (Ad-Hoc)
              </h3>
              <button
                onClick={() => setIsModalOpen(false)}
                className="text-slate-400 hover:text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleCreateMakluman} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-300 mb-1">
                    Komponen Utama (Kiraan Statistik)
                  </label>
                  <select
                    value={formDomain}
                    onChange={(e) => setFormDomain(e.target.value as MaklumanDomain)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-white font-bold"
                  >
                    <option value="KURIKULUM">📘 KURIKULUM</option>
                    <option value="HEM">📗 HAL EHWAL MURID (HEM)</option>
                    <option value="KOKURIKULUM">📙 KOKURIKULUM</option>
                    <option value="PENTADBIRAN">🏢 PENTADBIRAN</option>
                  </select>
                </div>

                <div>
                  <label className="block font-bold text-slate-300 mb-1">Jenis Aktiviti</label>
                  <select
                    value={formCategory}
                    onChange={(e) => setFormCategory(e.target.value as MaklumanCategory)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-white font-bold"
                  >
                    <option value="MESYUARAT">👥 Mesyuarat / PLC / Taklimat</option>
                    <option value="AKTIVITI">🎉 Aktiviti / Program Sekolah</option>
                    <option value="PERTANDINGAN">🏆 Pertandingan Koakademik / Sukan</option>
                    <option value="KURSUS">🎓 Kursus / Bengkel (LDP)</option>
                    <option value="TUGASAN">📋 Tugasan / Penghantaran Laporan</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-300 mb-1">Tajuk Mesyuarat / Aktiviti</label>
                <input
                  type="text"
                  required
                  value={formTitle}
                  onChange={(e) => setFormTitle(e.target.value)}
                  placeholder="cth: Mesyuarat Panitia Matematik Bil. 2/2027 atau Latihan Merentas Desa"
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white"
                />
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-300 mb-1">Tarikh</label>
                  <input
                    type="date"
                    required
                    value={formDueDate}
                    onChange={(e) => setFormDueDate(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-mono"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-300 mb-1">Masa</label>
                  <input
                    type="time"
                    value={formDueTime}
                    onChange={(e) => setFormDueTime(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-mono"
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-300 mb-1">Tindakan (Sasaran)</label>
                  <input
                    type="text"
                    value={formTindakan}
                    onChange={(e) => setFormTindakan(e.target.value)}
                    placeholder="cth: SEMUA GURU / KETUA PANITIA"
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-300 mb-1">Lokasi</label>
                  <input
                    type="text"
                    value={formLocation}
                    onChange={(e) => setFormLocation(e.target.value)}
                    placeholder="cth: Bilik Mesyuarat / Dewan"
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white"
                  />
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-300 mb-1">Catatan / Agenda Ringkas</label>
                <textarea
                  rows={2}
                  value={formDesc}
                  onChange={(e) => setFormDesc(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white"
                />
              </div>

              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setIsModalOpen(false)}
                  className="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 font-bold"
                >
                  Batal
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold shadow-lg"
                >
                  Simpan & Masuk ke Makluman
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};