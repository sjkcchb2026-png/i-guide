export type MaklumanDomain = 'KURIKULUM' | 'HEM' | 'KOKURIKULUM' | 'PENTADBIRAN' | 'CUTI';

export type MaklumanCategory =
  | 'TUGASAN'       // 日常/周期事务与报告
  | 'KURSUS'        // 课程与培训 (LDP / SPLKPM)
  | 'MESYUARAT'     // 会议与 PLC
  | 'PERTANDINGAN'  // 比赛与 Koakademik/MSSD
  | 'AKTIVITI';     // 学校活动与庆典

export type TimeHorizonFilter =
  | 'HARI_INI'
  | 'ESOK'
  | 'MINGGU_INI'
  | 'BULAN_INI'
  | 'TERTUNGGAK'
  | 'SEMUA';

export interface MaklumanTaskItem {
  id: string;
  title: string;
  description: string;
  domain: MaklumanDomain;           // KURIKULUM | HEM | KOKURIKULUM | PENTADBIRAN | CUTI
  category: MaklumanCategory;
  source: 'TAKWIM_UPLOAD' | 'AD_HOC'; // 区分校历上传 vs 临时新增
  mingguPersekolahan?: number | null;
  dueDate: string;                  // YYYY-MM-DD
  dueTime?: string;                 // HH:mm
  location?: string;
  tindakanLabel?: string;           // e.g. "SEMUA GURU", "KETUA PANITIA"
  priority: 'TINGGI' | 'SEDERHANA' | 'BIASA';
  targetType: 'SEMUA_GURU' | 'GURU_TERPILIH';
  targetTeacherIds: string[];
  completions: Record<
    string,
    {
      completed: boolean;
      completedAt: string;
      completedDateStr: string;
      isLate: boolean;
      daysLate: number;
    }
  >;
  whatsappLogs: Record<
    string,
    {
      count: number;
      lastSentAt: string;
      lastSentBy: string;
      history: { sentAt: string; sentBy: string; noteType: 'REMINDER' | 'OVERDUE_WARN' }[];
    }
  >;
  createdByTeacherId: string;
  createdByName: string;
  createdAt: string;
}

interface PaparanMaklumanViewProps {
  currentTeacher: TeacherProfile | null;
  allTeachers: TeacherProfile[];
  roleAssignments: RoleAssignment[];
  schoolProfile: SchoolProfile | null;
  isPrincipalOrAdmin: boolean;
  addToast: (msg: string, type?: 'info' | 'success' | 'warning') => void;
}

const MONTH_SHEETS = [
  'JAN', 'FEB', 'MAC', 'APRIL', 'MEI', 'JUN',
  'JULAI', 'OGOS', 'SEPT', 'OKT', 'NOV', 'DIS'
];

const getMalaysiaDateStr = (offsetDays = 0): string => {
  const d = new Date();
  d.setDate(d.getDate() + offsetDays);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

const diffDays = (dateA: string, dateB: string): number => {
  const a = new Date(`${dateA}T00:00:00`);
  const b = new Date(`${dateB}T00:00:00`);
  return Math.round((a.getTime() - b.getTime()) / (1000 * 60 * 60 * 24));
};

const formatWhatsAppPhone = (rawPhone?: string): string => {
  if (!rawPhone) return '';
  const digits = rawPhone.replace(/\D/g, '');
  if (!digits) return '';
  if (digits.startsWith('60')) return digits;
  if (digits.startsWith('0')) return `6${digits}`;
  return `60${digits}`;
};

