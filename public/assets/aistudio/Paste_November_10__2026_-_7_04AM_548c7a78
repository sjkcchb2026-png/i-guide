                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )}

      {/* 视图 2：Word 打印视图 */}
      {viewMode === 'CETAK_WORD' && (
        <div className="space-y-4">
          <div className="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between print:hidden">
            <span className="text-xs text-slate-300">
              Format jadual rasmi Microsoft Word sekolah untuk cetakan A4 terus ke dalam Fail Surat Masuk.
