import React, { useState, useEffect, useMemo } from 'react';
import {
  Mail,
  Plus,
  Printer,
  Clock,
  Send,
  Search,
  UserCheck,
  FolderOpen,
  CheckCircle2,
  Trash2,
  AlertCircle,
  MessageSquare,
  FileCheck,
  Eye,
  X
} from 'lucide-react';
import {
  collection,
  doc,
  setDoc,
  deleteDoc,
  onSnapshot,
  getDocs
} from 'firebase/firestore';
import { db, auth } from '../firebase';
import { TeacherProfile } from '../types/admin';
import { SchoolProfile, SchoolAcademicAssignment } from '../types/schoolData';

export type ArahanTindakanType =
  | 'UNTUK_TINDAKAN'
  | 'SILA_URUS'
  | 'SILA_BINCANG_DENGAN_GB'
  | 'UNTUK_SIMPANAN_FAIL'
  | 'UNTUK_DIPAMERKAN';

export type SuratActionMode =
  | 'UNTUK_TINDAKAN'        // 需采取行动 (强制截止日期)
  | 'SILA_URUS'             // 请处理/办理 (强制截止日期)
  | 'PERLU_HADIR'           // 需出席外出课程/会议 (自动 Keberadaan + Jadual Ganti)
  | 'HANTAR_LAPORAN'        // 需交报告/数据 (强制截止日期)
  | 'HADIR_DAN_TINDAKAN'    // 既需出席又需交报告/行动 (强制截止日期 + 自动代课)
  | 'SILA_BINCANG_GB'       // 请与校长商讨 (自动通知老师与校长)
  | 'UNTUK_DIPAMERKAN'      // 张贴展示
  | 'UNTUK_SIMPANAN_FAIL';  // 归档备查

export interface SuratMasukRecord {
  id: string;
  tarikhSurat: string;
  tarikhTerima: string;
  bulanTahunLabel: string;
  perkara: string;
  noRujukanLuar: string;
  noFailSekolah: string;
  tindakanTeacherIds: string[];
  arahanTindakan: ArahanTindakanType;
  tindakanCustomLabel: string;
  actionMode: SuratActionMode;
  tarikhHadirMula: string;
  tarikhHadirTamat: string;
  masaHadir: string;
  lokasiHadir: string;
  jenisKeberadaan: 'KURSUS' | 'URUSAN_RASMI';
  perluJadualGanti: boolean;
  tarikhAkhirLaporan: string; // 用于 Untuk tindakan, Sila urus, Hantar laporan 的必填截止日期
  catatanLaporan: string;
  linkedMaklumanIds: string[];
  linkedUnavailabilityIds: string[];
  linkedReliefAlertId: string;
  createdByUid: string;
  createdByName: string;
  createdAt: string;
}

interface SuratMasukManagerViewProps {
  currentUid?: string;
  currentUserName?: string;
  allTeachers?: TeacherProfile[];
  academicAssignments?: SchoolAcademicAssignment[];
  schoolProfile?: SchoolProfile | null;
  addToast?: (msg: string, type?: 'info' | 'success' | 'warning') => void;
}

const MALAY_MONTHS = [
  'JANUARI', 'FEBRUARI', 'MAC', 'APRIL', 'MEI', 'JUN',
  'JULAI', 'OGOS', 'SEPTEMBER', 'OKTOBER', 'NOVEMBER', 'DISEMBER'
];

const ARAHAN_LABELS: Record<ArahanTindakanType, string> = {
  UNTUK_TINDAKAN: 'Untuk tindakan',
  SILA_URUS: 'Sila urus',
  SILA_BINCANG_DENGAN_GB: 'Sila bincang dengan GB',
  UNTUK_SIMPANAN_FAIL: 'Untuk simpanan fail',
  UNTUK_DIPAMERKAN: 'Untuk dipamerkan',
};

const LOCAL_STORAGE_KEY = 'isepadu_surat_masuk_cache_v2';

// 递归清除所有 undefined，防止 Firestore 保存失败
function cleanFirestorePayload<T extends Record<string, any>>(obj: T): T {
  const cleaned: Record<string, any> = {};
  Object.keys(obj).forEach((key) => {
    const val = obj[key];
    if (val === undefined) {
      cleaned[key] = '';
    } else if (Array.isArray(val)) {
      cleaned[key] = val.filter((v) => v !== undefined);
    } else if (val !== null && typeof val === 'object' && !(val instanceof Date)) {
      cleaned[key] = cleanFirestorePayload(val);
    } else {
      cleaned[key] = val;
    }
  });
  return cleaned as T;
}

const formatDotDate = (yyyyMmDd?: string): string => {
  if (!yyyyMmDd) return '-';
  const parts = yyyyMmDd.split('-');
  if (parts.length !== 3) return yyyyMmDd;
  return `${parts[2]}.${parts[1]}.${parts[0]}`;
};

const formatWhatsAppPhone = (rawPhone?: string): string => {
  if (!rawPhone) return '';
  const digits = rawPhone.replace(/\D/g, '');
  if (!digits) return '';
  if (digits.startsWith('60')) return digits;
  if (digits.startsWith('0')) return `6${digits}`;
  return `60${digits}`;
};

export const SuratMasukManagerView: React.FC<SuratMasukManagerViewProps> = ({
  currentUid,
  currentUserName,
  allTeachers = [],
  academicAssignments = [],
  schoolProfile = null,
  addToast,
}) => {
  const [records, setRecords] = useState<SuratMasukRecord[]>(() => {
    try {
      const cached = localStorage.getItem(LOCAL_STORAGE_KEY);
      return cached ? JSON.parse(cached) : [];
    } catch {
      return [];
    }
  });
  const [fallbackTeachers, setFallbackTeachers] = useState<TeacherProfile[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [bannerMsg, setBannerMsg] = useState<{ text: string; type: 'success' | 'warning' } | null>(null);

  const [selectedMonth, setSelectedMonth] = useState<string>(() => {
    const now = new Date();
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  });
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [viewMode, setViewMode] = useState<'SENARAI' | 'CETAK_WORD'>('SENARAI');
  const [isModalOpen, setIsModalOpen] = useState<boolean>(false);
  const [saving, setSaving] = useState<boolean>(false);

  const todayStr = new Date().toISOString().slice(0, 10);
  const [tarikhSurat, setTarikhSurat] = useState<string>(todayStr);
  const [tarikhTerima, setTarikhTerima] = useState<string>(todayStr);
  const [perkara, setPerkara] = useState<string>('');
  const [noRujukanLuar, setNoRujukanLuar] = useState<string>('PPDMKH.');
  const [noFailSekolah, setNoFailSekolah] = useState<string>('Sjkcch.');
  const [selectedTeacherIds, setSelectedTeacherIds] = useState<string[]>([]);
  const [arahanTindakan, setArahanTindakan] = useState<ArahanTindakanType>('UNTUK_TINDAKAN');
  const [customTindakanText, setCustomTindakanText] = useState<string>('');
  const [actionMode, setActionMode] = useState<SuratActionMode>('UNTUK_TINDAKAN');

  const [tarikhHadirMula, setTarikhHadirMula] = useState<string>(todayStr);
  const [tarikhHadirTamat, setTarikhHadirTamat] = useState<string>(todayStr);
  const [masaHadir, setMasaHadir] = useState<string>('SEPANJANG_HARI');
  const [lokasiHadir, setLokasiHadir] = useState<string>('PPD Mukah / PKG');
  const [jenisKeberadaan, setJenisKeberadaan] = useState<'KURSUS' | 'URUSAN_RASMI'>('KURSUS');
  const [perluJadualGanti, setPerluJadualGanti] = useState<boolean>(true);

  const [tarikhAkhirLaporan, setTarikhAkhirLaporan] = useState<string>(todayStr);
  const [catatanLaporan, setCatatanLaporan] = useState<string>('');

  const notify = (msg: string, type: 'info' | 'success' | 'warning' = 'info') => {
    setBannerMsg({ text: msg, type: type === 'warning' ? 'warning' : 'success' });
    setTimeout(() => setBannerMsg(null), 5000);
    if (typeof addToast === 'function') {
      addToast(msg, type);
    }
  };

  useEffect(() => {
    if (allTeachers && allTeachers.length > 0) return;
    async function loadStaffList() {
      try {
        const snap = await getDocs(collection(db, 'teacher_profiles'));
        const list: TeacherProfile[] = [];
        snap.forEach((d) => {
          const data = d.data() as any;
          list.push({
            teacherId: data.teacherId || d.id,
            fullName: data.fullName || data.name || d.id,
            delimaEmail: data.delimaEmail || data.email || '',
            phone: data.phone || '',
            gender: data.gender || '',
            schoolCode: data.schoolCode || 'YCC3404',
            status: data.status || 'ACTIVE',
            position: data.position || data.category || 'GURU',
          });
        });
        if (list.length > 0) setFallbackTeachers(list);
      } catch (e) {
        console.warn('Fallback staff load skipped:', e);
      }
    }
    loadStaffList();
  }, [allTeachers]);

  const activeTeachers = useMemo(() => {
    const source = allTeachers && allTeachers.length > 0 ? allTeachers : fallbackTeachers;
    return source.filter((t) => t.status !== 'INACTIVE');
  }, [allTeachers, fallbackTeachers]);

  useEffect(() => {
    const unsub = onSnapshot(
      collection(db, 'surat_masuk_records'),
      (snap) => {
        const list: SuratMasukRecord[] = [];
        snap.forEach((d) =>
          list.push({ id: d.id, ...(d.data() as Omit<SuratMasukRecord, 'id'>) })
        );
        list.sort((a, b) => (a.tarikhSurat || '').localeCompare(b.tarikhSurat || ''));
        setRecords(list);
        try {
          localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(list));
        } catch {}
        setLoading(false);
      },
      (err) => {
        console.warn('Firestore listener fallback:', err);
        setLoading(false);
      }
    );
    return () => unsub();
  }, []);

  // 判断当前所选的 Tindakan 是否强制要求填写截止日期 (Untuk tindakan / Sila urus / Hantar laporan)
  const isDeadlineMandatory = useMemo(() => {
    return (
      arahanTindakan === 'UNTUK_TINDAKAN' ||
      arahanTindakan === 'SILA_URUS' ||
      actionMode === 'UNTUK_TINDAKAN' ||
      actionMode === 'SILA_URUS' ||
      actionMode === 'HANTAR_LAPORAN' ||
      actionMode === 'HADIR_DAN_TINDAKAN'
    );
  }, [arahanTindakan, actionMode]);

  const isHadirActive = useMemo(() => {
    return actionMode === 'PERLU_HADIR' || actionMode === 'HADIR_DAN_TINDAKAN';
  }, [actionMode]);

  // 同步 Arahan Tindakan 快捷按钮与下方 Automasi 模式
  const handleSelectArahan = (arahan: ArahanTindakanType) => {
    setArahanTindakan(arahan);
    if (arahan === 'UNTUK_TINDAKAN') {
      if (!isHadirActive) setActionMode('UNTUK_TINDAKAN');
    } else if (arahan === 'SILA_URUS') {
      if (!isHadirActive) setActionMode('SILA_URUS');
    } else if (arahan === 'SILA_BINCANG_DENGAN_GB') {
      setActionMode('SILA_BINCANG_GB');
    } else if (arahan === 'UNTUK_DIPAMERKAN') {
      setActionMode('UNTUK_DIPAMERKAN');
    } else if (arahan === 'UNTUK_SIMPANAN_FAIL') {
      setActionMode('UNTUK_SIMPANAN_FAIL');
    }
  };

  const handleSelectActionMode = (mode: SuratActionMode) => {
    setActionMode(mode);
    if (mode === 'UNTUK_TINDAKAN') setArahanTindakan('UNTUK_TINDAKAN');
    else if (mode === 'SILA_URUS') setArahanTindakan('SILA_URUS');
    else if (mode === 'SILA_BINCANG_GB') setArahanTindakan('SILA_BINCANG_DENGAN_GB');
    else if (mode === 'UNTUK_DIPAMERKAN') setArahanTindakan('UNTUK_DIPAMERKAN');
    else if (mode === 'UNTUK_SIMPANAN_FAIL') setArahanTindakan('UNTUK_SIMPANAN_FAIL');
    else if (mode === 'HANTAR_LAPORAN' || mode === 'HADIR_DAN_TINDAKAN') {
      if (arahanTindakan !== 'UNTUK_TINDAKAN' && arahanTindakan !== 'SILA_URUS') {
        setArahanTindakan('UNTUK_TINDAKAN');
      }
    }
  };

  const filteredRecords = useMemo(() => {
    return records.filter((r) => {
      const matchMonth = !selectedMonth || r.bulanTahunLabel === selectedMonth;
      const q = searchQuery.toLowerCase().trim();
      const matchQuery =
        !q ||
        (r.perkara || '').toLowerCase().includes(q) ||
        (r.noRujukanLuar || '').toLowerCase().includes(q) ||
        (r.noFailSekolah || '').toLowerCase().includes(q) ||
        (r.tindakanCustomLabel || '').toLowerCase().includes(q);
      return matchMonth && matchQuery;
    });
  }, [records, selectedMonth, searchQuery]);

  const formattedMonthHeading = useMemo(() => {
    if (!selectedMonth) return 'SURAT MASUK SEKOLAH';
    const [yr, mo] = selectedMonth.split('-');
    const mIdx = parseInt(mo, 10) - 1;
    const mName = MALAY_MONTHS[mIdx] || mo;
    return `SURAT MASUK BULAN ${mName} ${yr}`;
  }, [selectedMonth]);

  const handleSaveSuratMasuk = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!perkara.trim()) {
      notify('Sila masukkan Perkara / Tajuk Surat.', 'warning');
      return;
    }

    // 强制校验：当选择 Untuk tindakan 或 Sila urus 时，必须填写截止日期！
    if (isDeadlineMandatory && !tarikhAkhirLaporan.trim()) {
      notify(
        'Wajib diisi: Sila tetapkan Tarikh Akhir (Deadline) bagi surat berstatus "Untuk tindakan" atau "Sila urus"!',
        'warning'
      );
      return;
    }

    try {
      setSaving(true);
      const safeUid = currentUid || auth.currentUser?.uid || 'PO_ADMIN';
      const safeUserName =
        currentUserName || auth.currentUser?.displayName || auth.currentUser?.email || 'Pembantu Operasi';

      const suratId = `surat_${Date.now()}`;
      const bulanLabel = (tarikhTerima || todayStr).slice(0, 7);

      const selectedNames = selectedTeacherIds
        .map((id) => activeTeachers.find((t) => t.teacherId === id)?.fullName)
        .filter(Boolean) as string[];

      const baseNames =
        customTindakanText.trim() ||
        (selectedNames.length > 0
          ? selectedNames.join('\n')
          : arahanTindakan === 'UNTUK_SIMPANAN_FAIL'
          ? 'FAIL SEKOLAH'
          : arahanTindakan === 'UNTUK_DIPAMERKAN'
          ? 'PAPAN KENYATAAN'
          : 'GURU BESAR');

      const arahanLabelUpper = ARAHAN_LABELS[arahanTindakan].toUpperCase();
      const deadlineSuffix =
        isDeadlineMandatory && tarikhAkhirLaporan
          ? `\n(TARIKH AKHIR: ${formatDotDate(tarikhAkhirLaporan)})`
          : '';

      const finalTindakanLabel = `${baseNames.toUpperCase()}\n[${arahanLabelUpper}]${deadlineSuffix}`;

      const linkedMaklumanIds: string[] = [];
      const linkedUnavailabilityIds: string[] = [];
      let linkedReliefAlertId = '';

      if (isHadirActive) {
        linkedMaklumanIds.push(`makluman_hadir_${suratId}`);
        selectedTeacherIds.forEach((tId) => {
          linkedUnavailabilityIds.push(`unavail_${suratId}_${tId}`);
        });
        if (perluJadualGanti && selectedTeacherIds.length > 0) {
          linkedReliefAlertId = `relief_surat_${suratId}`;
        }
      }

      if (isDeadlineMandatory || actionMode === 'SILA_BINCANG_GB' || actionMode === 'UNTUK_DIPAMERKAN') {
        linkedMaklumanIds.push(`makluman_tindakan_${suratId}`);
      }

      const newRecord: SuratMasukRecord = cleanFirestorePayload({
        id: suratId,
        tarikhSurat: tarikhSurat || todayStr,
        tarikhTerima: tarikhTerima || todayStr,
        bulanTahunLabel: bulanLabel,
        perkara: perkara.trim().toUpperCase(),
        noRujukanLuar: noRujukanLuar.trim(),
        noFailSekolah: noFailSekolah.trim(),
        tindakanTeacherIds: selectedTeacherIds,
        arahanTindakan,
        tindakanCustomLabel: finalTindakanLabel,
        actionMode,
        tarikhHadirMula: isHadirActive ? tarikhHadirMula : '',
        tarikhHadirTamat: isHadirActive ? (tarikhHadirTamat || tarikhHadirMula) : '',
        masaHadir: isHadirActive ? masaHadir : '',
        lokasiHadir: isHadirActive ? lokasiHadir.trim() : '',
        jenisKeberadaan: isHadirActive ? jenisKeberadaan : 'KURSUS',
        perluJadualGanti: isHadirActive ? Boolean(perluJadualGanti) : false,
        tarikhAkhirLaporan: isDeadlineMandatory ? tarikhAkhirLaporan : '',
        catatanLaporan: catatanLaporan.trim(),
        linkedMaklumanIds,
        linkedUnavailabilityIds,
        linkedReliefAlertId,
        createdByUid: safeUid,
        createdByName: safeUserName,
        createdAt: new Date().toISOString(),
      });

      // 1. 立即更新前端状态与本地缓存
      setRecords((prev) => {
        const updated = [...prev, newRecord].sort((a, b) =>
          (a.tarikhSurat || '').localeCompare(b.tarikhSurat || '')
        );
        try {
          localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(updated));
        } catch {}
        return updated;
      });
      setSelectedMonth(bulanLabel);

      // 2. 保存主记录至 Firestore
      await setDoc(doc(db, 'surat_masuk_records', suratId), newRecord);

      // 3. 若包含出席外出 (PERLU_HADIR / HADIR_DAN_TINDAKAN)
      if (isHadirActive) {
        const maklumanHadirId = `makluman_hadir_${suratId}`;
        await setDoc(
          doc(db, 'makluman_tasks', maklumanHadirId),
          cleanFirestorePayload({
            id: maklumanHadirId,
            title: `[SURAT MASUK - HADIR] ${perkara.trim().toUpperCase()}`,
            description: `No. Ruj: ${noRujukanLuar} (${noFailSekolah}) | Lokasi: ${lokasiHadir} | Arahan: ${ARAHAN_LABELS[arahanTindakan]}`,
            domain: 'PENTADBIRAN',
            category: jenisKeberadaan === 'KURSUS' ? 'KURSUS' : 'MESYUARAT',
            source: 'AD_HOC',
            dueDate: tarikhHadirMula,
            dueTime: '08:00',
            location: lokasiHadir.trim(),
            tindakanLabel: finalTindakanLabel.replace(/\n/g, ' '),
            priority: 'TINGGI',
            targetType: selectedTeacherIds.length > 0 ? 'GURU_TERPILIH' : 'SEMUA_GURU',
            targetTeacherIds: selectedTeacherIds,
            completions: {},
            whatsappLogs: {},
            createdByTeacherId: safeUid,
            createdByName: `${safeUserName} (Daftar Surat Masuk)`,
            createdAt: new Date().toISOString(),
          })
        ).catch((err) => console.warn('Sync makluman_hadir warning:', err));

        for (const tId of selectedTeacherIds) {
          const noticeId = `unavail_${suratId}_${tId}`;
          await setDoc(
            doc(db, 'staff_unavailability', noticeId),
            cleanFirestorePayload({
              id: noticeId,
              noticeId,
              teacherId: tId,
              startDate: tarikhHadirMula,
              endDate: tarikhHadirTamat || tarikhHadirMula,
              timeType: 'SEPANJANG_HARI',
              startTime: '07:15',
              endTime: '13:15',
              reasonCode: jenisKeberadaan,
              reasonText: `[SURAT MASUK] ${perkara.trim().toUpperCase()} (${noRujukanLuar})`,
              notes: `Dijana automatik melalui Daftar Surat Masuk (${noFailSekolah}). Lokasi: ${lokasiHadir}`,
              status: 'PUBLISHED',
              createdAt: new Date().toISOString(),
              updatedAt: new Date().toISOString(),
              createdByUid: safeUid,
            })
          ).catch((err) => console.warn('Sync staff_unavailability warning:', err));
        }

        if (perluJadualGanti && selectedTeacherIds.length > 0) {
          const affectedClasses = academicAssignments
            .filter((asg) => selectedTeacherIds.includes(asg.teacherId) && asg.status !== 'INACTIVE')
            .map((asg) => ({
              teacherId: asg.teacherId || '',
              classId: asg.classId || '',
              className: asg.className || '',
              subjectCode: asg.subjectCode || '',
              subjectName: asg.subjectName || '',
              weeklyPeriods: Number(asg.weeklyPeriods || 0),
            }));

          await setDoc(
            doc(db, 'relief_alerts_from_surat', linkedReliefAlertId),
            cleanFirestorePayload({
              id: linkedReliefAlertId,
              suratId,
              perkara: perkara.trim().toUpperCase(),
              noRujukanLuar: noRujukanLuar.trim(),
              startDate: tarikhHadirMula,
              endDate: tarikhHadirTamat || tarikhHadirMula,
              absentTeacherIds: selectedTeacherIds,
              affectedClasses,
              status: 'PERLU_JADUAL_GANTI',
              createdAt: new Date().toISOString(),
            })
          ).catch((err) => console.warn('Sync relief_alerts warning:', err));
        }
      }

      // 4. 若为 Untuk tindakan / Sila urus / Hantar laporan / Sila bincang dengan GB / Untuk dipamerkan
      if (isDeadlineMandatory || actionMode === 'SILA_BINCANG_GB' || actionMode === 'UNTUK_DIPAMERKAN') {
        const maklumanTindakanId = `makluman_tindakan_${suratId}`;
        const prefixTag =
          actionMode === 'SILA_BINCANG_GB'
            ? '[SILA BINCANG DENGAN GB]'
            : actionMode === 'UNTUK_DIPAMERKAN'
            ? '[UNTUK DIPAMERKAN]'
            : `[${arahanLabelUpper}]`;

        await setDoc(
          doc(db, 'makluman_tasks', maklumanTindakanId),
          cleanFirestorePayload({
            id: maklumanTindakanId,
            title: `${prefixTag} ${perkara.trim().toUpperCase()}`,
            description: `Ruj. Surat: ${noRujukanLuar} (${noFailSekolah}) | Arahan: ${ARAHAN_LABELS[arahanTindakan]}${catatanLaporan ? ` | Catatan: ${catatanLaporan}` : ''}`,
            domain: 'PENTADBIRAN',
            category: 'TUGASAN',
            source: 'AD_HOC',
            dueDate: isDeadlineMandatory ? tarikhAkhirLaporan : todayStr,
            dueTime: '16:00',
            location: actionMode === 'SILA_BINCANG_GB' ? 'Bilik Guru Besar' : 'Pejabat Sekolah',
            tindakanLabel: finalTindakanLabel.replace(/\n/g, ' '),
            priority: 'TINGGI',
            targetType: selectedTeacherIds.length > 0 ? 'GURU_TERPILIH' : 'SEMUA_GURU',
            targetTeacherIds: selectedTeacherIds,
            completions: {},
            whatsappLogs: {},
            createdByTeacherId: safeUid,
            createdByName: `${safeUserName} (Daftar Surat Masuk)`,
            createdAt: new Date().toISOString(),
          })
        ).catch((err) => console.warn('Sync makluman_tindakan warning:', err));
      }

      setIsModalOpen(false);
      setPerkara('');
      setCustomTindakanText('');
      setSelectedTeacherIds([]);
      notify(
        `Surat Masuk [${ARAHAN_LABELS[arahanTindakan]}] berjaya disimpan & diselaraskan!`,
        'success'
      );
    } catch (err: any) {
      console.error('Save Surat Masuk error:', err);
      notify(`Disimpan dalam storan tempatan (${err.message})`, 'warning');
      setIsModalOpen(false);
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteSurat = async (id: string) => {
    setRecords((prev) => {
      const next = prev.filter((r) => r.id !== id);
      try {
        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(next));
      } catch {}
      return next;
    });
    try {
      await deleteDoc(doc(db, 'surat_masuk_records', id));
      notify('Rekod surat masuk telah dipadam.', 'info');
    } catch (e) {
      console.warn('Delete error:', e);
    }
  };

  const handleWhatsAppForSurat = (rec: SuratMasukRecord) => {
    const firstTeacher = activeTeachers.find((t) => rec.tindakanTeacherIds.includes(t.teacherId));
    const cleanPhone = formatWhatsAppPhone(firstTeacher?.phone);

    if (!cleanPhone) {
      notify(
        'Sila pilih guru yang mempunyai nombor telefon berdaftar untuk menghantar WhatsApp.',
        'warning'
      );
      return;
    }

    const schoolName = schoolProfile?.schoolName || 'SJK(C) CHUNG HUA BALINGIAN';
    const arahanText = ARAHAN_LABELS[rec.arahanTindakan || 'UNTUK_TINDAKAN'].toUpperCase();
    const lines = [
      `*[MAKLUMAN SURAT MASUK RASMI — ${schoolName}]*`,
      `📌 *Perkara:* ${rec.perkara}`,
      `📄 *No. Ruj. Surat:* ${rec.noRujukanLuar}`,
      `📁 *No. Fail Sekolah:* ${rec.noFailSekolah}`,
      `📅 *Tarikh Surat:* ${formatDotDate(rec.tarikhSurat)}`,
      `📝 *Arahan / Minit:* *${arahanText}*`,
      rec.tarikhAkhirLaporan
        ? `⏰ *Tarikh Akhir Tindakan / Laporan:* *${formatDotDate(rec.tarikhAkhirLaporan)}*`
        : '',
      rec.tarikhHadirMula
        ? `🗓️ *Tarikh Hadir:* ${rec.tarikhHadirMula} (${rec.lokasiHadir || '-'})`
        : '',
      ``,
      `Sila semak dan tandakan selesai (✔) dalam Paparan Makluman iSEPADU. Terima kasih.`,
    ].filter(Boolean);

    window.open(
      `https://wa.me/${cleanPhone}?text=${encodeURIComponent(lines.join('\n'))}`,
      '_blank',
      'noopener,noreferrer'
    );
  };

  return (
    <div className="flex-1 flex flex-col gap-6 max-w-6xl">
      {bannerMsg && (
        <div
          className={`p-4 rounded-2xl border text-xs font-bold flex items-center justify-between ${
            bannerMsg.type === 'warning'
              ? 'bg-amber-950/80 border-amber-600 text-amber-200'
              : 'bg-emerald-950/80 border-emerald-600 text-emerald-200'
          }`}
