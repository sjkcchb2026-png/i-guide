                  </th>
                  <th className="border border-black py-1.5 px-2.5 w-44">Tindakan</th>
                </tr>
              </thead>
              <tbody>
                {filteredRecords.map((rec, idx) => (
                  <tr key={rec.id} className="align-top">
                    <td className="border border-black py-2 px-2 text-center">
                      {idx + 1}.
                    </td>
                    <td className="border border-black py-2 px-2 text-center">
                      {formatDotDate(rec.tarikhSurat)}
                    </td>
                    <td className="border border-black py-2 px-3 uppercase">
                      {rec.perkara}
                    </td>
                    <td className="border border-black py-2 px-3">
                      <div>{rec.noRujukanLuar}</div>
                      <div className="mt-3">{rec.noFailSekolah}</div>
                    </td>
                    <td className="border border-black py-2 px-2.5 font-semibold uppercase whitespace-pre-line">
                      {rec.tindakanCustomLabel}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* 弹窗：新增来信与批示 */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4 print:hidden">
          <div className="bg-slate-900 border border-slate-800 rounded-3xl max-w-2xl w-full p-6 space-y-5 shadow-2xl max-h-[92vh] overflow-y-auto">
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <div>
                <h3 className="text-base font-black text-white">
                  Daftar Surat Masuk & Arahan Tindakan
                </h3>
                <p className="text-[11px] text-slate-400">
                  Pilih arahan tindakan (Untuk tindakan / Sila urus wajib menetapkan Tarikh Akhir).
                </p>
              </div>
              <button
                type="button"
                onClick={() => setIsModalOpen(false)}
                className="text-slate-400 hover:text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveSuratMasuk} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-300 mb-1">
                    Tarikh Surat (Pada Surat Rasmi)
                  </label>
                  <input
                    type="date"
                    required
                    value={tarikhSurat}
                    onChange={(e) => setTarikhSurat(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-white font-mono"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-300 mb-1">
                    Tarikh Terima (Penentu Bulan Daftar)
                  </label>
                  <input
                    type="date"
                    required
                    value={tarikhTerima}
                    onChange={(e) => setTarikhTerima(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-white font-mono"
                  />
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-300 mb-1">
                  Perkara / Tajuk Surat
                </label>
                <textarea
                  rows={2}
                  required
                  value={perkara}
                  onChange={(e) => setPerkara(e.target.value)}
                  placeholder="cth: SHOWCASE INOVASI K-I-D..."
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white uppercase font-semibold"
                />
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-300 mb-1">
                    Nama / No. Ruj. Surat Luar (PPDMKH / JPNSW / KPM)
                  </label>
                  <input
                    type="text"
                    required
                    value={noRujukanLuar}
                    onChange={(e) => setNoRujukanLuar(e.target.value)}
                    placeholder="cth: PPDMKH.500-5/3/4(21)"
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-white font-mono"
                  />
                </div>
                <div>
