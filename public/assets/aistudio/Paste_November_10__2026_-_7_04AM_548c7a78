                </label>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {[
                    {
                      id: 'UNTUK_TINDAKAN' as SuratActionMode,
                      title: '1. Untuk Tindakan (Wajib Tarikh Akhir)',
                      desc: 'Auto masuk Makluman Guru & Radar Tertunggak GB mengikut Tarikh Akhir',
                    },
                    {
                      id: 'SILA_URUS' as SuratActionMode,
                      title: '2. Sila Urus (Wajib Tarikh Akhir)',
                      desc: 'Auto masuk Makluman Guru & Radar Tertunggak GB mengikut Tarikh Akhir',
                    },
                    {
                      id: 'PERLU_HADIR' as SuratActionMode,
                      title: '3. Perlu Hadir (Kursus / Mesyuarat Luar)',
                      desc: 'Auto masuk Makluman + Auto Keberadaan Guru + Auto Jadual Ganti',
