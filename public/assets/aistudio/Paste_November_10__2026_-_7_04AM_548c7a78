                </div>
              </div>

              {/* 当选择 Untuk tindakan / Sila urus / Hantar laporan 时，强制显示必填的截止日期框 */}
              {isDeadlineMandatory && (
                <div className="p-4 rounded-2xl bg-rose-950/35 border-2 border-rose-500/50 space-y-3">
