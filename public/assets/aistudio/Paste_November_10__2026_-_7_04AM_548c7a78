                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-white font-mono"
                  />
                </div>
              </div>

              {/* TINDAKAN 区域：人员选择 + 5 大公文批示快捷选择 */}
