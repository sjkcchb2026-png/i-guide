                  </label>
                  <div className="flex flex-wrap gap-1.5">
                    {(
                      [
                        { id: 'UNTUK_TINDAKAN', label: 'Untuk tindakan (Wajib Tarikh Akhir)' },
                        { id: 'SILA_URUS', label: 'Sila urus (Wajib Tarikh Akhir)' },
                        { id: 'SILA_BINCANG_DENGAN_GB', label: 'Sila bincang dengan GB' },
                        { id: 'UNTUK_SIMPANAN_FAIL', label: 'Untuk simpanan fail' },
                        { id: 'UNTUK_DIPAMERKAN', label: 'Untuk dipamerkan' },
