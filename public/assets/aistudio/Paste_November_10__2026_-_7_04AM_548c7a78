                    {
                      id: 'HADIR_DAN_TINDAKAN' as SuratActionMode,
                      title: '5. Hadir & Perlu Tindakan / Laporan',
                      desc: 'Aktifkan kesemua automasi kehadiran, relief & tarikh akhir tindakan',
                    },
                    {
                      id: 'SILA_BINCANG_GB' as SuratActionMode,
                      title: '6. Sila Bincang Dengan GB',
                      desc: 'Auto maklum kepada Guru & GB untuk sesi perbincangan tindakan lanjut',
                    },
                    {
                      id: 'UNTUK_DIPAMERKAN' as SuratActionMode,
                      title: '7. Untuk Dipamerkan',
                      desc: 'Rekod surat masuk & makluman untuk dipamerkan di papan kenyataan',
                    },
                    {
                      id: 'UNTUK_SIMPANAN_FAIL' as SuratActionMode,
                      title: '8. Untuk Simpanan Fail Sahaja',
