                        <input
                          type="checkbox"
                          checked={checked}
                          onChange={(e) => {
                            if (e.target.checked) {
                              setSelectedTeacherIds((prev) => [...prev, t.teacherId]);
                            } else {
                              setSelectedTeacherIds((prev) =>
                                prev.filter((id) => id !== t.teacherId)
