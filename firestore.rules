rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sjkcchb2026@gmail.com' ||
        request.auth.token.email == 'sean3919531@gmail.com'
      );
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userSchoolCode() {
      return userExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['schoolCode']) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolCode is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolCode != ''
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolCode
          : (userExists() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['schoolId']) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId is string &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId != ''
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
              : 'YCC3404');
    }

    function docSchoolCode(data) {
      return data != null && data.keys().hasAny(['schoolCode']) && data.schoolCode is string && data.schoolCode != ''
        ? data.schoolCode
        : (data != null && data.keys().hasAny(['schoolId']) && data.schoolId is string && data.schoolId != ''
            ? data.schoolId
            : 'YCC3404');
    }

    function belongsToCallerSchool(data) {
      return isSuperAdmin() || docSchoolCode(data) == userSchoolCode();
    }

    function isSchoolAdmin(sc) {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           docSchoolCode(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) == sc) ||
          (userExists() &&
           userSchoolCode() == sc &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['PRINCIPAL', 'principal', 'ADMIN', 'admin', 'SYSTEM_ADMIN']) ||
          (exists(/databases/$(database)/documents/schools/$(sc)) && (
            get(/databases/$(database)/documents/schools/$(sc)).data.principalUid == request.auth.uid ||
            (get(/databases/$(database)/documents/schools/$(sc)).data.keys().hasAny(['adminEmails']) &&
             request.auth.token.email in get(/databases/$(database)/documents/schools/$(sc)).data.adminEmails)
          ))
        )
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (userExists() &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['PRINCIPAL', 'principal', 'ADMIN', 'admin', 'SYSTEM_ADMIN']) ||
        (exists(/databases/$(database)/documents/schools/$(userSchoolCode())) && (
          get(/databases/$(database)/documents/schools/$(userSchoolCode())).data.principalUid == request.auth.uid ||
          (get(/databases/$(database)/documents/schools/$(userSchoolCode())).data.keys().hasAny(['adminEmails']) &&
           request.auth.token.email in get(/databases/$(database)/documents/schools/$(userSchoolCode())).data.adminEmails)
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Health / Connection probes
    match /test/{docId} {
      allow read: if true;
    }
    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // Multi-tenant Schools Registry: Publicly readable for branding & join checks
    match /schools/{schoolCode} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && userSchoolCode() == schoolCode) ||
        (schoolCode != 'YCC3404' && (
          request.resource.data.principalUid == request.auth.uid ||
          (request.resource.data.keys().hasAny(['adminEmails']) &&
           request.auth.token.email in request.resource.data.adminEmails)
        ))
      );
      allow update: if isSignedIn() && isSchoolAdmin(schoolCode);
      allow delete: if isSuperAdmin();
    }

    // Admins registry: Readable by authenticated users; Client writes restricted to SuperAdmin
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // School Settings: Publicly readable for school branding; School Admin write
    match /school_settings/{settingId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolAdmin(docSchoolCode(request.resource.data)) ||
        (isAdmin() && belongsToCallerSchool(request.resource.data))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isSchoolAdmin(docSchoolCode(resource.data)) && docSchoolCode(request.resource.data) == docSchoolCode(resource.data)) ||
        (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data))
      );
      allow delete: if isSuperAdmin() || (isAdmin() && belongsToCallerSchool(resource.data));
    }

    // Institutional Configuration (Sessions, scale config, master locks)
    match /school_config/{configId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolAdmin(docSchoolCode(request.resource.data)) ||
        (isAdmin() && belongsToCallerSchool(request.resource.data))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isSchoolAdmin(docSchoolCode(resource.data)) && docSchoolCode(request.resource.data) == docSchoolCode(resource.data)) ||
        (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data))
      );
      allow delete: if isSuperAdmin() || (isAdmin() && belongsToCallerSchool(resource.data));
    }

    // School Governance & Security Configuration
    match /school_governance/{docId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Staff accounts: Owner/email match allowed across schools for login & onboarding; Admin operations scoped by schoolCode
    match /users/{userId} {
      allow get: if isSignedIn() && (
        isOwner(userId) ||
        resource.data.email == request.auth.token.email ||
        (isAdmin() && belongsToCallerSchool(resource.data))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.email == request.auth.token.email
      );
      allow create: if isSuperAdmin() ||
        isOwner(userId) ||
        (isSignedIn() && request.resource.data.email == request.auth.token.email) ||
        (isAdmin() && belongsToCallerSchool(request.resource.data));
      allow update: if isSuperAdmin() ||
        (isOwner(userId) && belongsToCallerSchool(resource.data)) ||
        (isSignedIn() && resource.data.email == request.auth.token.email) ||
        (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isAdmin() && belongsToCallerSchool(resource.data));
    }

    // Master Data: Personnel SSOT (Allow self email match for onboarding)
    match /personnel/{personnelId} {
      allow get: if isSignedIn() && (
        belongsToCallerSchool(resource.data) ||
        (resource.data.keys().hasAny(['email']) && resource.data.email == request.auth.token.email)
      );
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Academic Teachers (Allow self email match for onboarding)
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && (
        belongsToCallerSchool(resource.data) ||
        (resource.data.keys().hasAny(['email']) && resource.data.email == request.auth.token.email)
      );
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Academic Years
    match /academic_years/{yearId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Classes / Cohorts
    match /classes/{classId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Subject Teacher Allocations
    match /subject_allocations/{allocId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // School Timetable Matrix and Schedule Grids
    match /school_timetables/{docId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Governance & Portfolios
    match /governance_assignments/{gaId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Permanent Student Master Record
    match /student_master/{studentId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Active Year Student Class Enrollment
    match /students/{enrollmentId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Import Audit Sessions & Rollback Records
    match /import_sessions/{sessionId} {
      allow get: if isAdmin() && belongsToCallerSchool(resource.data);
      allow list: if isAdmin();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    match /rollback_records/{recordId} {
      allow get: if isAdmin() && belongsToCallerSchool(resource.data);
      allow list: if isAdmin();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Audit Trail: Appendable by signed-in actors within same school; readable by Admin
    match /audit_trail/{logId} {
      allow get: if isAdmin() && belongsToCallerSchool(resource.data);
      allow list: if isAdmin();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update, delete: if false;
    }

    // Academic PBD Results
    match /pbd_results/{resultId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Academic UASA Results
    match /uasa_results/{resultId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Academic OPR Reports (One Page Reporting - Aktiviti Panitia & PLC)
    match /academic_opr_reports/{reportId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Makluman Tasks, Checklists & WhatsApp Evidence
    match /makluman_tasks/{taskId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Kokurikulum Entities
    match /koko_memberships/{memberId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    match /koko_groups/{groupId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    match /koko_attendance/{attId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    match /koko_committees/{commId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    match /koko_settings/{settingId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    match /koko_activities/{actId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    match /bulletins/{bulletinId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Attendance Records: Staff can read their own records; Admin can read all in school
    match /attendance/{recordId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || (isAdmin() && belongsToCallerSchool(resource.data)));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if (isAdmin() && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(request.resource.data));
      allow update: if (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data));
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    match /attendance_records/{recordId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || (isAdmin() && belongsToCallerSchool(resource.data)));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if (isAdmin() && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(request.resource.data));
      allow update: if (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data));
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Isolated GPS Coordinates: Readable by Admin; Writable by Admin or user punch within same school
    match /attendance_geo/{recordId} {
      allow get: if isAdmin() && belongsToCallerSchool(resource.data);
      allow list: if isAdmin();
      allow create: if (isAdmin() && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(request.resource.data));
      allow update: if (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data));
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // User Attendance State
    match /user_attendance_state/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        userId.matches('^' + request.auth.uid + '.*') ||
        (resource != null && resource.data.userId == request.auth.uid && belongsToCallerSchool(resource.data)) ||
        (isAdmin() && belongsToCallerSchool(resource.data))
      );
      allow list: if isSignedIn() && (
        request.auth.uid == userId ||
        userId.matches('^' + request.auth.uid + '.*') ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        ((request.auth.uid == userId || userId.matches('^' + request.auth.uid + '.*') || (request.resource != null && request.resource.data.userId == request.auth.uid)) &&
          (request.resource == null || belongsToCallerSchool(request.resource.data))) ||
        (isAdmin() && (resource == null || belongsToCallerSchool(resource.data)) && (request.resource == null || belongsToCallerSchool(request.resource.data)))
      );
    }

    // School Calendar & Holidays
    match /school_calendar/{calId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isAdmin() && belongsToCallerSchool(request.resource.data);
      allow update: if isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isAdmin() && belongsToCallerSchool(resource.data);
    }

    // Absence / Leave / Official Duty Records
    match /absence_records/{recordId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || (isAdmin() && belongsToCallerSchool(resource.data)));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if (isAdmin() && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(request.resource.data));
      allow update: if (isAdmin() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data)) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data));
      allow delete: if (isAdmin() && belongsToCallerSchool(resource.data)) ||
        (isSignedIn() && resource.data.userId == request.auth.uid && belongsToCallerSchool(resource.data));
    }

    // Surat Masuk (Incoming Letters by Pembantu Operasi / Clerk / Admin)
    match /surat_masuk_records/{suratId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Staff Unavailability (Auto-generated by Surat Masuk for Kursus / Urusan Rasmi)
    match /staff_unavailability/{unavailId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Relief Alerts (Auto-generated by Surat Masuk for absent teachers needing substitute teachers)
    match /relief_alerts_from_surat/{alertId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }

    // Relief Schedules (Assigned substitute teachers per period)
    match /relief_schedules/{scheduleId} {
      allow get: if isSignedIn() && belongsToCallerSchool(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && belongsToCallerSchool(request.resource.data);
      allow update: if isSignedIn() && belongsToCallerSchool(resource.data) && belongsToCallerSchool(request.resource.data);
      allow delete: if isSignedIn() && belongsToCallerSchool(resource.data);
    }
  }
}
